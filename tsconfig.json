{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // scripts/ runs under `node --experimental-strip-types`, which requires
  // explicit .ts import extensions — incompatible with the bundler resolution
  // the app uses. It is checked by running it, not by tsc.
  //
  // vitest.config.ts is excluded because npm's dual-installed `vite` (one
  // nested under vitest, one hoisted) makes its own Plugin type structurally
  // incompatible with itself under tsc — a package-resolution artifact, not a
  // real type error. Vite/Vitest transpile it with esbuild, not tsc, so this
  // never affects `npm run test` or `npm run build`.
  "exclude": ["node_modules", "scripts", "vitest.config.mts"]
}
